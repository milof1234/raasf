# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Realtime Database & Auth)
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="ya-zadolbalcya.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://ya-zadolbalcya-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="ya-zadolbalcya"
VITE_FIREBASE_STORAGE_BUCKET="ya-zadolbalcya.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="736550801988"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"

# Server-side 2FA Resend API configuration (optional)
RESEND_API_KEY="MY_RESEND_API_KEY"
RESEND_SENDER_EMAIL="CosmoChat <onboarding@resend.dev>"
ADMIN_PHONE="9254699801"

# Cloudinary CDN Configuration (Image hosting, auto-compression, WebP/AVIF transformation)
CLOUDINARY_CLOUD_NAME="MY_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="MY_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="MY_CLOUDINARY_API_SECRET"
CLOUDINARY_UPLOAD_PRESET="MY_CLOUDINARY_UPLOAD_PRESET"

